# Bud Translate — environment template
#
# Copy to .env and fill in real values. .env is git-ignored.
# Docker Compose reads this; every service gets its slice via infra/docker-compose.yml.
#
# CI does NOT read this file. CI secrets live in GitHub Actions Secrets —
# see docs/SECRETS.example.md.

# ─── general ───────────────────────────────────────────────────────────
ENV=development                      # development | staging | production
PUBLIC_DOMAIN=api.example.com
LOG_LEVEL=info                       # never log transcripts, see docs/SECURITY.md

# ─── go-bff ────────────────────────────────────────────────────────────
PORT=8080

# Supabase — go-bff is the ONLY consumer of these. Never in the APK.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...dummy
SUPABASE_ANON_KEY=eyJhbGciOi...dummy
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_MAX_CONNS=25                # pool ceiling — phones don't get their own connections

JWT_SECRET=dummy-change-me
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

FCM_PROJECT_ID=bud-translate
FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm-service-account.json

# ─── livekit ───────────────────────────────────────────────────────────
# Shared by go-bff (issues tokens) and translation-pipeline (joins rooms).
# The API secret NEVER reaches the client — clients get per-call scoped tokens.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=dummysecretdummysecretdummysecret
LIVEKIT_TOKEN_TTL=900                # seconds

# ─── redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── translation-pipeline ──────────────────────────────────────────────
# STT provider is swappable — Deepgram signup was not completable from BD,
# so the spike runs on AssemblyAI. See docs/DECISIONS.md.
# Note: AssemblyAI real-time streaming has historically been English-only.
STT_PROVIDER=assemblyai              # assemblyai | deepgram | azure | google | whisper
ASSEMBLYAI_API_KEY=dummy_assemblyai_key
DEEPGRAM_API_KEY=dummy_deepgram_key
AZURE_SPEECH_STT_KEY=dummy_azure_stt_key
GOOGLE_STT_API_KEY=dummy_google_stt_key

TRANSLATION_PROVIDER=google          # google | deepl
GOOGLE_TRANSLATE_API_KEY=dummy_google_key
DEEPL_API_KEY=dummy_deepl_key

# Provider choice is the biggest cost lever — see docs/COST.md
TTS_PROVIDER=azure                   # azure | google | elevenlabs
AZURE_SPEECH_KEY=dummy_azure_key
AZURE_SPEECH_REGION=southeastasia
ELEVENLABS_API_KEY=dummy_elevenlabs_key

GOOGLE_VISION_API_KEY=dummy_vision_key

# ─── infra ─────────────────────────────────────────────────────────────
LIVEKIT_KEYS=APIxxxxxxxxxxxx: dummysecretdummysecretdummysecret
CLOUDFLARE_TUNNEL_TOKEN=dummy_tunnel_token
